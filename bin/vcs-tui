#!/usr/bin/env bash
# Walk up from the current directory to find a VCS checkout and launch the
# matching TUI: jjui for jujutsu, lazygit for git. Forwards any arguments and
# points SSH_AUTH_SOCK at the well-known agent socket first.
#
# Ported from bin/vcs_tui.ml.

set -euo pipefail
tmux_pane=

if [ "${1:-}" = "--tmux-pane" ]; then
  tmux_pane="${2:?--tmux-pane requires a pane ID}"
  shift 2

  remote_host="$(tmux show-window-options -v -t "$tmux_pane" @prj_remote_host 2>/dev/null || true)"
  remote_path="$(tmux show-window-options -v -t "$tmux_pane" @prj_remote_path 2>/dev/null || true)"

  if [ -n "$remote_host" ] && [ -n "$remote_path" ]; then
    shell_quote() {
      printf "'%s'" "${1//\'/\'\\\'\'}"
    }

    remote_command="cd -- $(shell_quote "$remote_path") && exec vcs-tui"
    for arg in "$@"; do
      remote_command+=" $(shell_quote "$arg")"
    done

    exec ssh -t "$remote_host" "$remote_command"
  fi
fi

# Echo the VCS kind (jujutsu/git) for the first ancestor that has one, or
# nothing. Stops before $HOME and /, matching the original walk.
find_vcs_up() {
  local dir
  dir="$(pwd)"
  while [ "$dir" != "$HOME" ] && [ "$dir" != "/" ]; do
    if [ -e "$dir/.jj" ]; then
      printf 'jujutsu'
      return 0
    elif [ -e "$dir/.git" ]; then
      printf 'git'
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

case "$(find_vcs_up || true)" in
jujutsu) tui=jjui ;;
git) tui=lazygit ;;
*)
  echo "No VCS directory found" >&2
  exit 1
  ;;
esac

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  SSH_AUTH_SOCK="$HOME/.ssh/ssh-auth.sock"
else
  SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-auth.sock"
fi
export SSH_AUTH_SOCK

exec "$tui" "$@"
