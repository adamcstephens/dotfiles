#!/usr/bin/env bash
# sd-enter UNIT [command...] — shell in a running unit's namespace, env, and uid
set -euo pipefail

unit=${1:?usage: sd-enter UNIT [command...]}
shift

pid=$(systemctl show -P MainPID "$unit")
if [[ -z $pid || $pid == 0 ]]; then
  echo "sd-enter: $unit is not running" >&2
  exit 1
fi

read -r uid gid < <(awk '/^Uid:/{u=$2} /^Gid:/{g=$2} END{print u, g}' "/proc/$pid/status")
wd=$(sudo readlink "/proc/$pid/cwd")
mapfile -d '' -t envs < <(sudo cat "/proc/$pid/environ")

if [[ ${#envs[@]} -eq 0 ]]; then
  echo "sd-enter: empty environ — check sudo" >&2
  exit 1
fi
unit_binary() {
  local name=$1 binary
  binary=$(sudo find "/proc/$pid/root/nix/store" -path "*/bin/$name" -executable -print -quit)
  if [[ -z $binary ]]; then
    echo "sd-enter: $name is unavailable in $unit" >&2
    return 1
  fi
  printf '%s\n' "${binary#"/proc/$pid/root"}"
}

setpriv=$(unit_binary setpriv)
env=$(unit_binary env)
bash=$(unit_binary bash)
cmd=("$@")
if [[ ${#cmd[@]} -eq 0 ]]; then
  cmd=(PS1="(${unit%.service}) \\w \\$ " "$bash" --noprofile --norc -i)
fi

exec sudo systemd-analyze unit-shell "$unit" \
  "$setpriv" \
  --reuid "$uid" --regid "$gid" --keep-groups --inh-caps=-all -- \
  "$env" -i -C "$wd" "${envs[@]}" "${cmd[@]}"
