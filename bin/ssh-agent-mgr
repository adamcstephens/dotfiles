#!/usr/bin/env bash

socket="$SSH_AUTH_SOCK"

if [ -z "$SSH_AUTH_SOCK" ] && [ -z "$SSH_TTY" ] && [ -z "$ET_VERSION" ]; then
  for sock in "$XDG_RUNTIME_DIR/ssh-agent" \
    "$XDG_RUNTIME_DIR/yubikey-agent/yubikey-agent.sock" \
    "$XDG_RUNTIME_DIR/ssh-tpm-agent" \
    "$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"; do
    if [ -S "$sock" ]; then
      socket=$sock
    fi
  done
fi

if ! ssh-add -l &>/dev/null; then
  ssh-add >&2 || true

  if [ -e ~/.ssh/id_ed25519_sk_rk ]; then
    ssh-add ~/.ssh/id_ed25519_sk_rk >&2 || true
  fi

  if [ "$(uname)" = "Darwin" ]; then
    /usr/bin/ssh-add --apple-use-keychain >&2 || true
  fi
fi

export SSH_AUTH_SOCK="$socket"
if ! ssh-add -l &>/dev/null; then
  echo "Emtpy ssh-agent" >&2
fi

echo -n "$socket"
