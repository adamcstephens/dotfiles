#!/usr/bin/env bash
# Locate the best ssh-agent socket and print its path.
#
# Candidates are tried in priority order and the first agent that actually has
# keys loaded wins. If no candidate has keys, the first reachable (but empty)
# agent is used. In a mux/remote context (tmux, ssh, eternal terminal, zellij)
# the inherited SSH_AUTH_SOCK is tried first.
#
# Originally ported from bin/ssh_agent_mgr.ml, then reworked to select by key
# presence rather than mere socket existence.

set -euo pipefail

# Candidate sockets, in priority order. Entries whose env var is unset expand
# to an empty string and are skipped below.
socket_candidates() {
  printf '%s\n' \
    "${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/yubikey-agent/yubikey-agent.sock}" \
    "${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/ssh-tpm-agent}" \
    "${HOME:+$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh}" \
    "${HOME:+$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock}" \
    "${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/ssh-agent}"
}

# Full ordered candidate list. In a mux/remote context the inherited socket is
# tried ahead of the discovered candidates.
candidates() {
  if [ -n "${TMUX:-}" ] || [ -n "${SSH_TTY:-}" ] || [ -n "${ET_VERSION:-}" ] || [ -n "${ZELLIJ:-}" ]; then
    printf '%s\n' "${SSH_AUTH_SOCK:-}"
  fi
  socket_candidates
}

chosen=""
first_reachable=""

# ssh-add -l exits 0 (has keys), 1 (reachable but empty), 2 (unreachable).
while IFS= read -r sock; do
  [ -n "$sock" ] || continue
  [ -S "$sock" ] || continue

  if SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1; then
    rc=0
  else
    rc=$?
  fi

  if [ "$rc" -eq 0 ]; then
    chosen="$sock"
    break
  elif [ "$rc" -eq 1 ] && [ -z "$first_reachable" ]; then
    first_reachable="$sock"
  fi
done < <(candidates)

if [ -n "$chosen" ]; then
  :
elif [ -n "$first_reachable" ]; then
  chosen="$first_reachable"
  echo "No agent with keys, falling back to reachable agent" >&2
else
  echo "No usable ssh-agent found" >&2
fi

printf '%s' "$chosen"
