#!/usr/bin/env bash

if [ -z "$1" ]; then
  DIR="$PWD"
else
  DIR="$1"
fi

while [ ! -d "$DIR/.git" ]; do
  DIR=$(dirname "$DIR")

  if [ "$DIR" == "$HOME" ]; then
    echo "Reached HOME, exiting."
    exit 1
  fi
done

# strip display unless we're in kitty, until we can find a fix for terminal corruption
if [ -z "$KITTY_PID" ]; then
  unset DISPLAY
fi

# wait
export IS_EDITOR=true

exec ~/.dotfiles/bin/em -e "(progn (magit-status \"${DIR}\") (delete-other-windows))"
