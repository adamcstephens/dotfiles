#!/usr/bin/env python3
"""Wake and shell: persistent SSH wrapper that auto-reconnects via WoL."""

import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import termios


def is_reachable(host, timeout=1):
    """Check if host is reachable via TCP connect to SSH port."""
    try:
        with socket.create_connection((host, 22), timeout=timeout):
            return True
    except OSError:
        return False


def cooked_mode():
    fd = sys.stdin.fileno()
    attrs = termios.tcgetattr(fd)
    attrs[3] |= termios.ISIG | termios.ICANON | termios.ECHO  # lflag
    termios.tcsetattr(fd, termios.TCSAFLUSH, attrs)


class ReachabilityMonitor:
    """Background thread that monitors host reachability and sends preemptive WoL."""

    def __init__(self, name, mac, interval=5):
        self.name = name
        self.mac = mac
        self.interval = interval
        self.reachable = True
        self.wol_sent = False
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def start(self):
        self._stop.clear()
        self.reachable = True
        self.wol_sent = False
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self):
        self._stop.set()

    def _run(self):
        while not self._stop.is_set():
            self._stop.wait(self.interval)
            if self._stop.is_set():
                break

            reachable = is_reachable(self.name)
            self.reachable = reachable

            if not reachable and not self.wol_sent:
                print(f"\n{self.name} became unreachable, sending preemptive WoL...")
                subprocess.run(["ssh", "blank", "wakey-wake", self.mac])
                self.wol_sent = True


def wake_and_wait(name, mac):
    """Send WoL and wait for SSH port to become reachable."""
    subprocess.run(["ssh", "-O", "exit", name], stderr=subprocess.DEVNULL)
    subprocess.run(["ssh", "blank", "wakey-wake", mac], check=True)

    print(f"Waiting for {name} to come up...")
    while not is_reachable(name):
        time.sleep(1)
    print(f"{name} is up, connecting...")


def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <name> <mac>", file=sys.stderr)
        sys.exit(1)

    name = sys.argv[1]
    mac = sys.argv[2]

    while True:
        wake_and_wait(name, mac)

        monitor = ReachabilityMonitor(name, mac)

        # Forward SIGINT/SIGTERM to the SSH child, not us
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)

        monitor.start()
        proc = subprocess.run(["ssh", "-4", name])
        monitor.stop()

        if proc.returncode == 0:
            break

        rows, cols = shutil.get_terminal_size()
        print(f"\033[{rows - 2};1H", end="", flush=True)
        print("\r\033", flush=True)

        print(f"\r\033[KSSH disconnected (exit code {proc.returncode})", flush=True)

        signal.signal(signal.SIGINT, signal.SIG_DFL)  # recapture signals
        sys.stdout.write("\x1b[=0;1u")  # reset kitty keyboard stack
        cooked_mode()
        sys.stdout.write("\x1b[!p")  # soft reset
        sys.stdout.write("\x1b[?1004l")  # explicitly kill focus tracking

        if input("Reconnect? [Y/n] ").strip().lower() in ("y", "Y", ""):
            continue
        else:
            break


if __name__ == "__main__":
    main()
