#!/usr/bin/env python3
"""Wake and shell: persistent SSH wrapper that auto-reconnects via WoL."""

import signal
import socket
import subprocess
import sys
import threading
import time


def is_reachable(host, timeout=1):
    """Check if host is reachable via TCP connect to SSH port."""
    try:
        with socket.create_connection((host, 22), timeout=timeout):
            return True
    except OSError:
        return False


class ReachabilityMonitor:
    """Background thread that monitors host reachability and sends preemptive WoL."""

    def __init__(self, name, mac, interval=5):
        self.name = name
        self.mac = mac
        self.interval = interval
        self.reachable = True
        self.wol_sent = False
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def start(self):
        self._stop.clear()
        self.reachable = True
        self.wol_sent = False
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self):
        self._stop.set()

    def _run(self):
        while not self._stop.is_set():
            self._stop.wait(self.interval)
            if self._stop.is_set():
                break

            reachable = is_reachable(self.name)
            self.reachable = reachable

            if not reachable and not self.wol_sent:
                print(f"\n{self.name} became unreachable, sending preemptive WoL...")
                subprocess.run(["ssh", "blank", "wakey-wake", self.mac])
                self.wol_sent = True


def wake_and_wait(name, mac):
    """Send WoL and wait for SSH port to become reachable."""
    subprocess.run(["ssh", "-O", "exit", name])
    subprocess.run(["ssh", "blank", "wakey-wake", mac], check=True)

    print(f"Waiting for {name} to come up...")
    while not is_reachable(name):
        time.sleep(1)
    print(f"{name} is up, connecting...")


def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <name> <mac>", file=sys.stderr)
        sys.exit(1)

    name = sys.argv[1]
    mac = sys.argv[2]

    # Forward SIGINT/SIGTERM to the SSH child, not us
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    # Initial connection: always wake first
    wake_and_wait(name, mac)

    monitor = ReachabilityMonitor(name, mac)

    while True:
        monitor.start()
        proc = subprocess.run(["ssh", "-4", name])
        monitor.stop()

        if proc.returncode == 0:
            break

        print(f"\nSSH disconnected (exit code {proc.returncode})")

        # Close stale control master
        subprocess.run(["ssh", "-O", "exit", name])

        if monitor.wol_sent:
            # WoL already sent preemptively, just wait for it
            print(f"WoL already sent, waiting for {name}...")
            while not is_reachable(name):
                time.sleep(1)
            print(f"{name} is up, connecting...")
        elif is_reachable(name):
            print(f"Reconnecting to {name}...")
        else:
            print(f"{name} is unreachable, sending WoL...")
            wake_and_wait(name, mac)


if __name__ == "__main__":
    main()
