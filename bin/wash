#!/usr/bin/env python3
"""Wake and shell: persistent SSH wrapper that auto-reconnects via WoL."""

import shutil
import signal
import socket
import subprocess
import sys
import time
import termios


def is_reachable(host, timeout=1):
    """Check if host is reachable via TCP connect to SSH port."""
    try:
        with socket.create_connection((host, 22), timeout=timeout):
            return True
    except OSError:
        return False


def cooked_mode():
    fd = sys.stdin.fileno()
    attrs = termios.tcgetattr(fd)
    attrs[3] |= termios.ISIG | termios.ICANON | termios.ECHO  # lflag
    termios.tcsetattr(fd, termios.TCSAFLUSH, attrs)


def wake_and_wait(name, mac):
    """Send WoL and wait for SSH port to become reachable."""
    subprocess.run(["ssh", "-O", "exit", name], stderr=subprocess.DEVNULL)
    subprocess.run(["ssh", "blank", "wakey-wake", mac], check=True)

    print(f"Waiting for {name} to come up...")
    while not is_reachable(name):
        time.sleep(1)
    print(f"{name} is up, connecting...")


def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <name> <mac>", file=sys.stderr)
        sys.exit(1)

    name = sys.argv[1]
    mac = sys.argv[2]

    while True:
        wake_and_wait(name, mac)

        # Forward SIGINT/SIGTERM to the SSH child, not us
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)

        proc = subprocess.run(["ssh", "-4", name])

        if proc.returncode == 0:
            break

        rows, cols = shutil.get_terminal_size()
        print(f"\033[{rows - 2};1H", end="", flush=True)
        print("\r\033", flush=True)

        print(f"\r\033[KSSH disconnected (exit code {proc.returncode})", flush=True)

        signal.signal(signal.SIGINT, signal.SIG_DFL)  # recapture signals
        sys.stdout.write("\x1b[=0;1u")  # reset kitty keyboard stack
        cooked_mode()
        sys.stdout.write("\x1b[!p")  # soft reset
        sys.stdout.write("\x1b[?1004l")  # explicitly kill focus tracking

        if input("Reconnect? [Y/n] ").strip().lower() in ("y", "Y", ""):
            continue
        else:
            break


if __name__ == "__main__":
    main()
