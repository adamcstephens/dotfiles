#!/usr/bin/env python3
import argparse
import base64
import json
import os
import subprocess
import sys
from pathlib import Path


def set_state(state: str, message: str) -> None:
    encoded = base64.b64encode(message.encode()).decode()
    print(f"\033]7501;state={state}:app=mux-review:msg={encoded}\033\\", end="", flush=True)


def run_review(pr: str, args: list[str]) -> int:
    command = ["direnv", "exec", ".", "nixpkgs-review", "pr", pr, *args]
    if sys.platform == "darwin":
        command.insert(0, "caffeinate")
    set_state("working", f"Reviewing PR {pr}")
    status = subprocess.run(command, check=False).returncode
    result = "completed" if status == 0 else f"failed (exit {status})"
    set_state("done" if status == 0 else "error", f"Review of PR {pr} {result}")
    print(f"\nReview {result}. Press Enter to close.", end="", flush=True)
    sys.stdin.readline()
    return status if status >= 0 else 128 - status


def main() -> int:
    parser = argparse.ArgumentParser(description="Review a nixpkgs PR in a mux pane.")
    parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("pr", metavar="PR", help="PR number or GitHub URL")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="arguments passed to nixpkgs-review")
    args = parser.parse_args()
    pr = args.pr.removeprefix("https://github.com/NixOS/nixpkgs/pull/")

    if args.worker:
        return run_review(pr, args.args)

    worker = [sys.executable, str(Path(__file__).resolve()), "--worker"]
    if os.environ.get("REX_SESSION"):
        command = [
            "rex",
            "do",
            "--session",
            os.environ["REX_SESSION"],
            "--block",
            os.environ["REX_BLOCK"],
            "--eval",
            """
local origin = assert(rex.session.describe_block({ block_id = rex.block_id }))
local layer = assert(rex.session.new_layer({
  window_id = origin.block.window_id,
  bounds = { 0.05, 0.05, 0.9, 0.9 },
  focus = false,
  layout = rex.layout.block({
    flavor = "com.superlogical.terminal.shell",
    label = rex.args.label,
    options = { command = rex.args.command, cwd = rex.args.cwd },
  }),
}))
return assert(rex.call("session.set_layer_state", {
  session_id = rex.session_id,
  layer_id = layer.layer_id,
  state = "minimized",
}))
""",
            "--args",
            json.dumps(
                {
                    "label": f"review-{pr}",
                    "cwd": os.getcwd(),
                    "command": [
                        "sh",
                        "-c",
                        'origin=$1; shift; "$@"; status=$?; rex block focus --session "$REX_SESSION" "$origin"; exit "$status"',
                        "sh",
                        os.environ["REX_BLOCK"],
                        *worker,
                        pr,
                        "--no-shell",
                        "--post-result",
                        *args.args,
                    ],
                }
            ),
        ]
    elif os.environ.get("TUIOS_SESSION"):
        command = [
            "tuios",
            "new-window",
            pr,
            "--cwd",
            os.getcwd(),
            "--",
            *worker,
            pr,
            "--no-shell",
            "--post-result",
            *args.args,
        ]
    else:
        print("Unsupported mux environment", file=sys.stderr)
        return 1
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
