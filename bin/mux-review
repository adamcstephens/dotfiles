#!/usr/bin/env bash

if [ -z "$1" ]; then
  echo "Usage: mux-review <PR number or URL> <args>"
  exit 1
fi

PR="${1#https://github.com/NixOS/nixpkgs/pull/}"
TITLE="review-$PR"
shift

if [ -n "$REX_SESSION" ]; then
  rex window new "$TITLE" --cwd "$PWD" -- bash -c '
    direnv exec . nixpkgs-review pr "$@"
    status=$?
    if [ "$status" -ne 0 ]; then
      message=$(printf "Review of PR %s failed (exit %s)" "$1" "$status" | base64 | tr -d "\n")
      printf "\033]7501;state=error:app=mux-review:msg=%s\033\\" "$message"
      printf "\nReview failed (exit %s). Press Enter to close." "$status"
      read -r
    fi
    exit "$status"
  ' mux-review "$PR" "$@"
elif [ -n "$TUIOS_SESSION" ]; then
  tuios new-window "$PR" --cwd "$PWD" -- sh -c '
    direnv exec . nixpkgs-review pr "$@"
    rc=$?
    [ "$rc" -eq 0 ] && exit 0

    tuios status error --app nixpkgs-review --msg "Failed with exit status $rc"
    printf "\nFailed (exit %s). Press Enter to close." "$rc"
    read -r _
    exit "$rc"
  ' mux-review "$PR" "$@"
else
  echo "Unsupported mux environment"
  exit 1
fi
