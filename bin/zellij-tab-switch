#!/usr/bin/env python3

import logging
import subprocess
import sys

logger = logging.getLogger(__name__)


def run(command: str, input: list[str] | str | None = None):
    result = subprocess.run(command, shell=True, capture_output=True, input=input, encoding="UTF-8")

    if result.returncode != 0:
        print(result.stderr)
        print(f"Failed to run [{command}]")
        sys.exit(1)

    return result.stdout.strip()


def tab_selector():
    finder = "fzf --height 22 --no-sort --filepath-word --reverse"
    zj_tabs = run("zellij action query-tab-names")

    tab = run(finder, input=zj_tabs)

    if tab in zj_tabs.splitlines():
        run(f"zellij action go-to-tab-name '{tab}'")


if __name__ == "__main__":
    tab_selector()
