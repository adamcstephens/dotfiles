#!/usr/bin/env nu

def main [ project_path: string = "" ] {
  let is_tmux = if $env.TMUX? != null { true } else { false }
  let is_zellij = if $env.ZELLIJ? != null { true } else { false }

  let project = if $project_path != "" { $project_path | path expand } else {
    if $is_tmux or $is_zellij {
      zoxide query --list | zf --height 22
    } else {
      zoxide query --list | rofi -dmenu
    }
  } | str trim

  if $project != null and $project != "" {
    print $":: Opening project ($project)"
    if $is_tmux {
      let wname = $project | path basename | str replace --all --regex '[^a-zA-Z0-9]' ''
      let tmux_windows = tmux list-windows -F '#{window_index},#{window_name}'  | from csv --trim all | rename index name
      let prj_windows = $tmux_windows| filter { |w| $w.name == $wname} | get index

      if ($prj_windows | length) > 0 {
        exec tmux select-window -t $wname
      }

      tmux new-window -c $project -n $wname
      tmux select-window -t $wname
      tmux send-keys 'vim .' 'C-m'
      tmux split-window -h -c $project
      tmux select-pane -l
    } else if $is_zellij {
      let tabname = $project | path basename

      if (zellij action query-tab-names | lines | find --regex $"^($tabname)$" | length) == 0 {
        zellij action new-tab --name $tabname --cwd $project --layout prj
      }

      zellij action go-to-tab-name $tabname
    } else {
      ghostty $project
      codium -n $project
    }
  } else {
    echo $"!! No project found, \"($project)\", exiting"
    exit 1
  }
}
