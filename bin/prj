#!/usr/bin/env python3

import argparse
import json
import logging
import os
import re
import subprocess
import sys
import time

logger = logging.getLogger(__name__)

is_kitty = "KITTY_PID" in os.environ
is_tmux = "TMUX" in os.environ
is_wayland = "WAYLAND_DISPLAY" in os.environ
is_zellij = "ZELLIJ" in os.environ


def gen_remotes():
    hosts = ["nixos2"]

    return str.join("\n", hosts)


def run(command: str, input: str | None = None):
    if input is not None:
        input = run(input)

    result = subprocess.run(command, shell=True, capture_output=True, input=input, encoding="UTF-8")

    if result.returncode != 0:
        print(result.stderr)
        print(f"Failed to run [{command}]")
        sys.exit(1)

    return result.stdout.strip()


def existing_tab_index(tabs: list[dict], wname: str) -> int:
    return next(filter(lambda tab: tab["title"] == wname, tabs), {"id": -1})["id"]


def tmux_to_kitty(tab: str) -> dict:
    tab_split = tab.split(",")

    return {"id": int(tab_split[0]), "title": tab_split[1]}


def prj_finder(remote: bool = False) -> str:
    command: str
    project: str

    finder = "sk --reverse --height 22 --header 'Select a project dir' --info hidden --tiebreak index --exact"

    if remote:
        selected_remote = run(finder, input=gen_remotes())
        run(f"ssh {selected_remote} true")
        project = run(
            finder,
            input=run(f"ssh {selected_remote} zoxide query --list"),
        )
        project = f"{selected_remote}:{project}"
    else:
        if is_kitty or is_tmux or is_zellij:
            command = finder
        elif is_wayland:
            command = "rofi -dmenu"
        else:
            logger.error("unsupported environment")
            sys.exit(1)

        project = run(command, input="zoxide query --list")

    return project


def kitty_active_window() -> dict:
    return [i for i in json.loads(run("kitty @ ls")) if i["is_active"]][0]


def open_project(project: str, remote: bool = False):
    wname: str
    project_s: list[str] = []

    if remote:
        project_s = project.split(":")
        wname = re.sub("[^a-zA-Z0-9:]", "", f"{project_s[0]}:{os.path.basename(project_s[1])}")
    else:
        wname = re.sub("[^a-zA-Z0-9]", "", os.path.basename(project))
        run(f"zoxide add {project}")

    existing_tab: int

    if is_tmux:
        if remote:
            print("unsupported tmux + remote")
            sys.exit(1)

        tabs = list(
            map(
                tmux_to_kitty,
                run("tmux list-windows -F '#{window_index},#{window_name}'").split("\n"),
            )
        )
        existing_tab = existing_tab_index(tabs, wname)

        if existing_tab > 0:
            run(f"tmux select-window -t {wname}")
        else:
            run(f"tmux new-window -c {project} -n {wname}")
            run(f"tmux select-window -t {wname}")
            run("tmux send-keys 'vim .' 'C-m'")
            run(f"tmux split-window -h -c {project}")
            run("tmux select-pane -l")

    elif is_zellij:
        tabs = run("zellij action query-tab-names").splitlines()

        if wname in tabs:
            run(f"zellij action go-to-tab-name {wname}")
        else:
            run(f"zellij action new-tab --name {wname} --layout prj --cwd {project}")
            run("zellij action write-chars 'vim .'")
            # send newline
            run("zellij action write 13")

    elif is_kitty:
        # needs to come after tmux in case tmux in kitty
        existing_tab = existing_tab_index(kitty_active_window()["tabs"], wname)
        new_tab_command = f"kitty @ launch --tab-title {wname} --type tab"
        if not remote:
            new_tab_command = f"{new_tab_command} --cwd {project}"

        if existing_tab > 0:
            run(f"kitty @ focus-tab -m id:{existing_tab}")
        else:
            new_tab = run(new_tab_command)
            if remote:
                second_window = run(f"kitty @ new-window --match id:{new_tab} --dont-take-focus")
                third_window = run(f"kitty @ new-window --match id:{new_tab} --dont-take-focus")

                run(f'''kitty @ send-text --match id:{new_tab} "{connect_command("one")} {project_s[0]}\\n"''')
                run(f'''kitty @ send-text --match id:{second_window} "{connect_command("two")} {project_s[0]}\\n"''')
                run(f'''kitty @ send-text --match id:{third_window} "{connect_command("three")} {project_s[0]}\\n"''')

                time.sleep(1)

                run(f'kitty @ send-text --match id:{new_tab} "cd {project_s[1]}\\n"')
                run(f'kitty @ send-text --match id:{second_window} "cd {project_s[1]}\\n"')
                run(f'kitty @ send-text --match id:{third_window} "cd {project_s[1]}\\n"')

                run(f'kitty @ send-text --match id:{new_tab} "vim .\\n"')
            else:
                run(f'kitty @ send-text --match id:{new_tab} "vim .\\n"')
                run(f"kitty @ new-window --match id:{new_tab} --cwd {project} --dont-take-focus")


def connect_command(identifier: str) -> str:
    rundir: str
    if "XDG_RUNTIME_DIR" in os.environ:
        rundir = f"{os.getenv('XDG_RUNTIME_DIR')}/et/{identifier}"
    elif "TMPDIR" in os.environ:
        rundir = f"{os.getenv('TMPDIR')}et/{identifier}"
    else:
        rundir = f"/tmp/et/{identifier}"

    if not os.path.exists(rundir):
        os.makedirs(rundir)
        os.chmod(rundir, 0o0700)

    return f"et --forward-ssh-agent --silent --logdir {rundir}"


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("project", nargs="?", help="path")
    parser.add_argument("--remote", action="store_true", help="remote")
    args = parser.parse_args()

    project: str

    if args.project is None:
        project = prj_finder(remote=args.remote)
        if project == "":
            print("no project selected")
            sys.exit(1)
    else:
        project = os.path.abspath(args.project)

    print(f":: Opening project {project}")
    open_project(project=project, remote=args.remote)
