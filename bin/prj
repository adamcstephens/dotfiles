#!/usr/bin/env python3

import argparse
import json
import logging
import os
import re
import shlex
import subprocess
import sys
import time

logger = logging.getLogger(__name__)

is_kitty = "KITTY_PID" in os.environ
is_tmux = "TMUX" in os.environ
is_wayland = "WAYLAND_DISPLAY" in os.environ
is_zellij = "ZELLIJ" in os.environ

FINDER = "fzf --height 22 --filepath-word --reverse --scheme=path"


def gen_remotes():
    hosts = ["branch", "kale.incus", "nixos2.local"]

    return str.join("\n", hosts)


def run(command: str, input: str | None = None):
    result = subprocess.run(command, shell=True, capture_output=True, input=input, encoding="UTF-8")

    if result.returncode != 0:
        print(result.stderr)
        print(f"Failed to run [{command}]")
        sys.exit(1)

    return result.stdout.strip()


def existing_tab_index(tabs: list[dict], wname: str) -> int:
    return next(filter(lambda tab: tab["title"] == wname, tabs), {"id": -1})["id"]


def tmux_to_kitty(tab: str) -> dict:
    tab_split = tab.split(",")

    return {"id": int(tab_split[0]), "title": tab_split[1]}


def tmux_panes_left_to_right(window_target: str) -> list[str]:
    pane_lines = run(f"tmux list-panes -t {shlex.quote(window_target)} -F '#{{pane_id}} #{{pane_left}}'").splitlines()
    panes = []

    for pane in pane_lines:
        pane_id, pane_left = pane.split(" ", 1)
        panes.append((pane_id, int(pane_left)))

    panes.sort(key=lambda p: p[1])
    return [pane_id for pane_id, _ in panes]


def prj_finder(remote: bool = False) -> str:
    command: str
    project: str

    if remote:
        selected_remote = run(FINDER, input=gen_remotes())
        run(f"ssh {selected_remote} true")
        project = run(
            FINDER,
            input=run(f"ssh {selected_remote} zoxide query --list"),
        )
        project = f"{selected_remote}:{project}"
    else:
        if is_kitty or is_tmux or is_zellij:
            command = FINDER
        elif is_wayland:
            command = "rofi -dmenu"
        else:
            logger.error("unsupported environment")
            sys.exit(1)

        project = run(command, input=run("zoxide query --list"))

    return project


def kitty_active_window() -> dict:
    return [i for i in json.loads(run("kitty @ ls")) if i["is_active"]][0]


def open_project(project: str, remote: bool = False):
    wname: str
    project_s: list[str] = []

    if remote:
        project_s = project.split(":")
        host = project_s[0]
        project = project_s[1]
        wname = re.sub("[^a-zA-Z0-9:@\\-]", "", f"{os.path.basename(project)}@{host.split('.')[0]}")
    else:
        wname = re.sub("[^a-zA-Z0-9\\-]", "", os.path.basename(project))
        run(f"zoxide add {project}")

    existing_tab: int

    if is_tmux:
        tabs = list(
            map(
                tmux_to_kitty,
                run("tmux list-windows -F '#{window_index},#{window_name}'").split("\n"),
            )
        )
        existing_tab = existing_tab_index(tabs, wname)

        if existing_tab > 0:
            run(f"tmux select-window -t {wname}")
        else:
            if remote:
                if os.path.exists(project):
                    run(f"tmux new-window -c {shlex.quote(project)} -n {wname}")
                else:
                    run(f"tmux new-window -n {wname}")

                run(f"tmux select-window -t {wname}")
                run("tmux split-window -h")
                run("tmux split-window -h")
                run("tmux select-layout even-horizontal")
                pane_ids = tmux_panes_left_to_right(wname)
                remote_shell_cmd = f"ssh {host} -t {shlex.quote(f'cd {project} && exec $SHELL -l')}"
                remote_vim_cmd = f"ssh {host} -t {shlex.quote(f'cd {project} && vim .; exec $SHELL -l')}"
                middle_pane = pane_ids[1]

                for pane_id in pane_ids:
                    pane_cmd = remote_vim_cmd if pane_id == middle_pane else remote_shell_cmd
                    run(f"tmux send-keys -t {pane_id} {shlex.quote(pane_cmd)} 'C-m'")

                run(f"tmux select-pane -t {middle_pane}")
                run("tmux select-pane -l")
            else:
                run(f"tmux new-window -c {shlex.quote(project)} -n {wname}")
                run(f"tmux select-window -t {wname}")
                run(f"tmux split-window -h -c {shlex.quote(project)}")
                run("tmux send-keys 'vim .' 'C-m'")
                run(f"tmux split-window -h -c {shlex.quote(project)}")
                run("tmux select-layout even-horizontal")
                run("tmux select-pane -l")

    elif is_zellij:
        tabs = run("zellij action query-tab-names").splitlines()

        if wname in tabs:
            run(f"zellij action go-to-tab-name {wname}")
        else:
            if remote:
                if os.path.exists(project):
                    # if we have that directory locally, we'll use it
                    run(f"zellij action new-tab --name {wname} --layout prj --cwd {project}")
                else:
                    run(f"zellij action new-tab --name {wname} --layout prj")

                run("zellij action toggle-active-sync-tab")
                run(f"zellij action write-chars 'ssh {host}'")
                run("zellij action write 13")
                time.sleep(0.2)
                run(f"zellij action write-chars 'cd {project}'")
                run("zellij action write 13")
                run("zellij action toggle-active-sync-tab")

            else:
                run(f"zellij action new-tab --name {wname} --layout prj --cwd {project}")

            run("zellij action write-chars 'vim .'")
            # send newline
            run("zellij action write 13")

    elif is_kitty:
        # needs to come after tmux in case tmux in kitty
        existing_tab = existing_tab_index(kitty_active_window()["tabs"], wname)
        new_tab_command = f"kitty @ launch --tab-title {wname} --type tab"
        if not remote:
            new_tab_command = f"{new_tab_command} --cwd {project}"

        if existing_tab > 0:
            run(f"kitty @ focus-tab -m id:{existing_tab}")
        else:
            new_tab = run(new_tab_command)
            if remote:
                second_window = run(f"kitty @ new-window --match id:{new_tab} --dont-take-focus")
                third_window = run(f"kitty @ new-window --match id:{new_tab} --dont-take-focus")

                run(f'''kitty @ send-text --match id:{new_tab} "ssh {host}\\n"''')
                run(f'''kitty @ send-text --match id:{second_window} "ssh {host}\\n"''')
                run(f'''kitty @ send-text --match id:{third_window} "ssh {host}\\n"''')

                time.sleep(1)

                run(f'kitty @ send-text --match id:{new_tab} "cd {project}\\n"')
                run(f'kitty @ send-text --match id:{second_window} "cd {project}\\n"')
                run(f'kitty @ send-text --match id:{third_window} "cd {project}\\n"')

                run(f'kitty @ send-text --match id:{new_tab} "vim .\\n"')
            else:
                run(f'kitty @ send-text --match id:{new_tab} "vim .\\n"')
                run(f"kitty @ new-window --match id:{new_tab} --cwd {project} --dont-take-focus")


def open_ssh():
    selected_remote = run(FINDER, input=gen_remotes())
    run(f"ssh {selected_remote} true")
    wname: str = f"ssh@{selected_remote}"

    if is_tmux:
        tabs = list(
            map(
                tmux_to_kitty,
                run("tmux list-windows -F '#{window_index},#{window_name}'").split("\n"),
            )
        )
        existing_tab = existing_tab_index(tabs, wname)

        if existing_tab > 0:
            run(f"tmux select-window -t {wname}")
        else:
            run(f"tmux new-window -n {wname}")
            run(f"tmux select-window -t {wname}")
            run("tmux split-window -h")
            run("tmux split-window -h")
            run("tmux select-layout even-horizontal")
            pane_ids = tmux_panes_left_to_right(wname)

            for pane_id in pane_ids:
                run(f"tmux send-keys -t {pane_id} {shlex.quote(f'ssh {selected_remote}')} 'C-m'")

            run(f"tmux select-pane -t {pane_ids[1]}")
            run("tmux select-pane -l")

    elif is_zellij:
        tabs = run("zellij action query-tab-names").splitlines()

        if wname in tabs:
            run(f"zellij action go-to-tab-name {wname}")
        else:
            run(f"zellij action new-tab --name {wname} --layout prj")

            run("zellij action toggle-active-sync-tab")
            run(f"zellij action write-chars 'ssh {selected_remote}'")
            run("zellij action write 13")
            time.sleep(0.2)
            run("zellij action toggle-active-sync-tab")

    elif is_kitty:
        print("unsupported tmux + ssh")
        sys.exit(1)


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("project", nargs="?", help="path")
    parser.add_argument("--remote", "-r", action="store_true", help="remote")
    parser.add_argument("--ssh", "-s", action="store_true", help="open ssh tab")
    args = parser.parse_args()

    project: str

    if args.ssh:
        open_ssh()
    elif args.project is None:
        project = prj_finder(remote=args.remote)
        if project == "":
            print("no project selected")
            sys.exit(1)
    else:
        project = os.path.abspath(args.project)

    print(f":: Opening project {project}")
    open_project(project=project, remote=args.remote)
