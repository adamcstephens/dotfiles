#!/usr/bin/env nu

let nixpkgs_root = $env.HOME + "/git/nixpkgs"

def get_worktree [branch: string] {
  $nixpkgs_root + "-worktree/" + ($branch | str replace "/" "-")
}

def workdir [branch: string, ] {
  let worktree = get_worktree $branch

  if not ($worktree | path dirname | path exists) {
    mkdir -v ($worktree | path dirname)
  }

  cd $nixpkgs_root

  let branch_test = do { git rev-parse --verify $branch } | complete
  let worktree_args = ["-B", $branch, "--checkout", "--lock", $worktree, "upstream/master"]

  if not ($worktree | path exists) {
    print ($worktree_args | prepend $worktree)
    git fetch upstream master
    git worktree add ...$worktree_args

    cd $worktree
    git push --set-upstream origin $"($branch):($branch)"
    cd -
  }

  if not (($worktree + "/.envrc") | path exists) {
    cd $worktree
    "use flake ~/.dotfiles#nixpkgs" | save ".envrc"
    direnv allow
  }

  zoxide add $worktree

  $worktree
}

def clean [confirm = false] {
  cd $nixpkgs_root
  git switch master
  git pull

  let worktrees = git worktree list | lines | parse '{path} {commit} [{branch}] {rest}' | each { |w|
    let commit = $w.commit | str trim
    $w | merge {
      commit: $commit,
      merged: ((git branch --contains $commit master | find master | length) > 0)
    }
  } | filter { |w|
    ($w.path != $env.PWD) and $w.branch != "master" and $w.merged == true
  } | par-each --threads 4 { |w|
    print $":: removing ($w.branch)"
    git worktree remove -ff $w.path
    git branch -D $w.branch
  }
}

def main [--codium (-c), --emacs (-e), --prj (-p), --replace (-r), action: string, name: string = ""] {
  if ($action == "workdir") {
    if name? == "" {
      print "!! must provide name"
      exit 1
    }

    let worktree = workdir $name
    if ($prj) {
      prj $worktree
    }

    if ($env.PWD != ($worktree | path expand)) and ("KITTY_WINDOW_ID" in $env) and ("DISPLAY" in $env or "WAYLAND_DISPLAY" in $env) {
      kitty --single-instance $worktree
      exec kitty @ close-window -m ("id:" + $env.KITTY_WINDOW_ID)
    }
  } else if ($action == "pr") {
    if name? == "" {
      print "!! must provide name"
      exit 1
    }

    let worktree = workdir $"pr($name)"

    cd $worktree
    gh pr checkout -f $name

    if ($prj) {
      if $replace {
        prj --replace $worktree
      } else {
        prj $worktree
      }
    }
  } else if ($action == "clean") {
    clean
  } else {
    print ("!! Unsupported command " + $action)
    exit 1
  }
}
