#!/usr/bin/env python3

import os, sys
from dotlib import run


def find_git_up():
    dir = os.path.abspath(os.path.curdir)

    while not os.path.exists(os.path.join(dir, ".git")):
        if dir == "/":
            print("Could not find git root")
            sys.exit(1)

        dir = os.path.dirname(dir)

    print(f"Found git at {dir}")
    os.chdir(dir)


find_git_up()

heads = [".git/refs/remotes/origin/HEAD", ".git/refs/remotes/upstream/HEAD"]

head: str = ""

for h in heads:
    if os.path.exists(h):
        head = h
        break

if head == "":
    print("Failed to find git HEAD")
    sys.exit(1)

head = head.replace(".git/", "")

ref = run(f"git symbolic-ref {head}")

if ref is None:
    print("Failed to load symbolic-ref")
    sys.exit(1)

branch = os.path.basename(ref)

run(f"git switch {branch}", capture_output=False)
run("git pull", capture_output=False)
print(f"Switched and updated to {branch}")
