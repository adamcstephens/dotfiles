#!/usr/bin/env python3

import dotlib
import os
import sys


dotlib.find_git_up()

heads = [".git/refs/remotes/origin/HEAD", ".git/refs/remotes/upstream/HEAD"]

head: str = ""

for h in heads:
    if os.path.exists(h):
        head = h
        break

if head == "":
    print("Failed to find git HEAD")
    sys.exit(1)

head = head.replace(".git/", "")

ref = dotlib.run(f"git symbolic-ref {head}")

if ref is None:
    print("Failed to load symbolic-ref")
    sys.exit(1)

branch = os.path.basename(ref)

dotlib.run(f"git switch {branch}", capture_output=False)
dotlib.run("git pull --prune", capture_output=False)
print(f"Switched and updated to {branch}")
