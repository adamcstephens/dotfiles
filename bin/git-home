#!/usr/bin/env nu

def main [] {
  let head = [
    ".git/refs/remotes/origin/HEAD",
    ".git/refs/remotes/upstream/HEAD"

  ] | where {|f| $f | path exists }

  if ($head | length) < 1 {
    print "No HEAD found"
    git remote set-head origin -a
    exec git home
  }

  let branch = git symbolic-ref ($head | first | str replace '.git/' '') | str replace --regex '.*/' ''

  git switch $branch
  git pull
}
