#!/usr/bin/env python3

import argparse
import dotlib
import os
import sys


dotlib.find_git_up()

is_jj: bool = os.path.isdir(".jj")


def get_default_branch() -> str:
    heads = [".git/refs/remotes/upstream/HEAD", ".git/refs/remotes/origin/HEAD"]

    head: str = ""

    for h in heads:
        if os.path.exists(h):
            head = h
            break

    if head == "":
        print("Failed to find git HEAD")
        sys.exit(1)

    head = head.replace(".git/", "")

    ref = dotlib.run(f"git symbolic-ref {head}")

    if ref is None:
        print("Failed to load symbolic-ref")
        sys.exit(1)

    return os.path.basename(ref)


parser = argparse.ArgumentParser()
parser.add_argument("-r", "--rebase", action="store_true", help="rebase (jj only)")
args = parser.parse_args()

branch = get_default_branch()

if is_jj:
    dotlib.run("jj git fetch --all-remotes", capture_output=False)
    if args.rebase:
        dotlib.run(f"jj rebase --destination {branch}", capture_output=False)
        print(f"Rebased on {branch}")
    else:
        dotlib.run(f"jj new {branch}", capture_output=False)
        print(f"New commit on {branch}")
else:
    dotlib.run(f"git switch {branch}", capture_output=False)
    dotlib.run("git pull --prune", capture_output=False)
    print(f"Switched and updated to {branch}")
