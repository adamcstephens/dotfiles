#!/usr/bin/env python3

import argparse
import dotlib
import os
import sys


dotlib.find_git_up()

is_jj: bool = os.path.isdir(".jj")


def get_default_remote_branch() -> tuple[str, str]:
    remotes = ["upstream", "origin"]
    refs = " ".join(f"refs/remotes/{r}/HEAD" for r in remotes)

    output = dotlib.run(f'git for-each-ref --format "%(refname) %(symref)" {refs}')

    if output is None:
        print("Failed to list remote HEADs")
        sys.exit(1)

    heads = dict(line.split() for line in output.splitlines())

    for remote in remotes:
        head = heads.get(f"refs/remotes/{remote}/HEAD")

        if head is not None:
            return remote, os.path.basename(head)

    print("Failed to find git HEAD")
    sys.exit(1)


parser = argparse.ArgumentParser()
parser.add_argument("-r", "--rebase", action="store_true", help="rebase (jj only)")
args = parser.parse_args()

remote, branch = get_default_remote_branch()

if is_jj:
    target = f"{branch}@{remote}"

    dotlib.run("jj git fetch --all-remotes", capture_output=False)
    if args.rebase:
        dotlib.run(f"jj rebase --destination {target}", capture_output=False)
        print(f"Rebased on {target}")
    else:
        dotlib.run(f"jj new {target}", capture_output=False)
        print(f"New commit on {target}")
else:
    dotlib.run(f"git switch {branch}", capture_output=False)
    dotlib.run(f"git pull --prune {remote} {branch}", capture_output=False)
    print(f"Switched and updated to {branch} from {remote}")
