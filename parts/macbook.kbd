(defcfg
  process-unmapped-keys yes

  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defalias
  two (layer-while-held two)

  alt_a (tap-hold 180 180 a lalt)
  met_s (tap-hold 180 180 s lmet)
  ctl_d (tap-hold 180 180 d lctl)
  sft_f (tap-hold 180 180 f lsft)

  sft_j (tap-hold 180 180 j rsft)
  ctl_k (tap-hold 180 180 k rctl)
  met_l (tap-hold 180 180 l lmet)
  alt_; (tap-hold 180 180 ; ralt)

  lay_v (tap-hold 200 200 v @two)
  lay_n (tap-hold 200 200 n @two)

  capsesc (tap-hold-release 200 200 esc lctl)

  ch_up S-A-up
  ch_dn S-A-down
  )

(defsrc
  tab      q       w       e       r       t       y       u       i       o       p       [        ]       \
  caps     a       s       d       f       g       h       j       k       l       ;       '        ret
  lsft     z       x       c       v       b       n       m       ,       .       /       rsft
)

(deflayer default
  tab      q       w       e       r       t       y       u       i       o       p       [        ]       \
  @capsesc @alt_a  @met_s  @ctl_d  @sft_f  g       h       @sft_j  @ctl_k  @met_l  @alt_;  '        ret
  lsft     z       x       c       @lay_v  b       @lay_n  m       ,       .       /       rsft
)

(deflayer two
  tab      q       w       e       @ch_up  t       y       pgup    up      pgdn    p       [        ]       \
  caps     a       s       d       @ch_dn  g       h       lft     down    rght    end     '        ret
  lsft     z       x       c       v       b       n       m       ,       .       /       rsft
)

