{
  "extends": ["dotfiles/nix", "dotfiles/network"],
  "meta": {
    "name": "personal",
    "description": "Adam's personal profile"
  },
  "environment": {
    "set_vars": { "HISTFILE": "", "fish_history": "" }
  },
  "filesystem": {
    "allow": [
      "~/.config/claude",
      "~/.config/claude-personal",
      "~/.config/omp",
      "~/.local/share/atuin",
      "~/.local/share/dotvim",
      "~/.local/state/dotvim"
    ],
    "read": [
      "~/.dotfiles",
      "~/.agents",
      "~/.config/home-manager",
      "~/.config/starship.toml",
      "~/.config/atuin",
      "~/.config/fish",
      "~/.config/git",
      "~/.config/jj",
      "~/.config/jjui",
      "~/.local/share/fish",
      "~/.ssh/signing-key.pub",
      "~/git"
    ],
    "read_file": ["~/.bashrc"],
    "unix_socket": [
      "~/.local/share/atuin/atuin.sock",
      "/Users/adam/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
    ],
    "bypass_protection": [
      "~/.dotfiles/apps/zsh/zshrc",
      "~/.config/fish",
      "~/.ssh/signing-key.pub"
    ],
    "suppress_save_prompt": ["~/Applications", "~/projects", "~/tmp"]
  }
}
