{
  "extends": ["claude-code"],
  "meta": {
    "name": "claude-code-dotfiles",
    "version": "1.0.0",
    "description": "Runtime-discovered path additions for claude",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": ["/usage-credits"],
    "read": [
      "/nix/store",
      "~/.config/claude",
      "~/.config/claude-personal",
      "~/.config/gh",
      "~/.config/git",
      "~/.config/jj",
      "~/.config/pi",
      "~/.dotfiles",
      "~/.dotfiles/apps/agents/plugins/dexter-lsp",
      "~/.dotfiles/apps/agents/skills",
      "~/.pi"
    ],
    "write": [
      "~/.config/claude",
      "~/.config/claude-personal",
      "~/.config/pi",
      "~/.pi"
    ],
    "allow_file": [],
    "read_file": [],
    "write_file": [
      "~/Applications/Claude Code URL Handler.app/Contents/MacOS/claude"
    ],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [],
    "suppress_save_prompt": [
      "~/Library/Application Support/Arc/User Data",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Application Support/Vivaldi",
      "~/Applications/Claude Code URL Handler.app/Contents/MacOS",
      "/Users",
      "~/",
      "~/.config"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": []
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "interactive": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
