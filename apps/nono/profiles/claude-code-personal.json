{
  "extends": ["nolabs-ai/claude"],
  "meta": {
    "name": "claude-code-dotfiles",
    "version": "1.0.0",
    "description": "Runtime-discovered path additions for claude",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {
      "review": {
        "type": "terminal",
        "url": null,
        "auth": null,
        "timeout_secs": 60,
        "mode": null,
        "backends": []
      }
    },
    "approval_defaults": {
      "backend": "review",
      "timeout_secs": null
    },
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": ["~/.local/share/direnv", "~/.config/claude"],
    "read": [
      "/nix/store",
      "~/.dotfiles",
      "~/.orca",
      "~/.config/home-manager",
      "~/.config/starship",
      "~/.CFUserTextEncoding",
      "~/.agents",
      "~/.config/claude",
      "~/.config/direnv",
      "~/.config/gh",
      "~/.config/git",
      "~/.config/jj",
      "~/.config/nix",
      "~/.dotfiles/apps/agents",
      "~/.dotfiles/apps/jujutsu",
      "~/.ssh/known_hosts"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [
      "~/.ssh/known_hosts",
      "~/.bashrc",
      "~/.dotfiles/apps/shell_generic.sh",
      "~/.dotfiles/apps/aliases.sh"
    ],
    "write_file": [
      "~/Applications/Claude Code URL Handler.app/Contents/MacOS/claude"
    ],
    "unix_socket": ["/nix/var/nix/daemon-socket/socket"],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": ["~/Library/Keychains"],
    "bypass_protection": ["/nix/store", "~/.ssh/known_hosts"],
    "suppress_save_prompt": [
      "~/Library/Application Support/Arc/User Data",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Application Support/Vivaldi",
      "~/Applications/Claude Code URL Handler.app/Contents/MacOS",
      "~/.config",
      "~/.bash_history"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": true,
    "allow_domain": [
      "*.github.com",
      "github.com",
      "*.amazonaws.com",
      "*.bitfreighter.dev",
      "*.anthropic.com",
      "*.claude.com",
      "*.datadoghq.com",
      "*.clickhouse.cloud"
    ],
    "deny_domain": [],
    "open_port": [0],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "environment": {
    "allow_vars": ["PATH", "HOME", "TERM", "LANG", "MANPATH", "AWS_*"],
    "deny_vars": [],
    "case_insensitive_vars": false,
    "set_vars": {}
  },
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "open_urls": {
    "allow_origins": [
      "https://publicapi.turvo.com",
      "https://mcp.clickhouse.cloud"
    ],
    "allow_localhost": false
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": [
    "(allow file-read-data (literal \"/Users\") (regex #\"^/Users/[^/]+(/git|/.config)?$\") )"
  ]
}
