[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair calendars]
conflict_resolution = "b wins"
a = "calendars_local"
b = "calendars_dav"
collections = ["from b"]
metadata = ["color", "displayname"]

[storage calendars_local]
type = "filesystem"
path = "~/.local/state/vdirsyncer/calendars/"
fileext = ".ics"

[storage calendars_dav]
type = "caldav"
url.fetch = ["command", "rbw", "get", "vdirsyncer-dav", "--field", "uris"]
username.fetch = ["command", "rbw", "get", "vdirsyncer-dav", "--field", "username"]
password.fetch = ["command", "rbw", "get", "vdirsyncer-dav"]
