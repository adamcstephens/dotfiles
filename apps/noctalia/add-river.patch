+#include "compositors/river-classic/river-classic-workspace-backend.h"
+
+#include "core/log.h"
+#include "river-classic-control-unstable-v1-client-protocol.h"
+#include "river-classic-status-unstable-v1-client-protocol.h"
+
+#include <algorithm>
