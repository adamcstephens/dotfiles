@@ -0,0 +1,318 @@
+#include "test_check.h"
+#include "wayland/output_power_service.h"
+#include "wlr-output-power-management-unstable-v1-client-protocol.h"
+#include "wlr-output-power-management-unstable-v1-server-protocol.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <vector>
+#include <wayland-client.h>
+#include <wayland-server.h>
+
+namespace {
+
+  class WaylandPeer {
+  public:
+    struct Output {
+      wl_global* global = nullptr;
+      wl_resource* resource = nullptr;
+      wl_resource* power = nullptr;
+      std::vector<std::uint32_t> modes;
+      unsigned controlsCreated = 0;
+      unsigned releases = 0;
+      bool failed = false;
+    };
+
+    explicit WaylandPeer(bool advertiseManager = true) {
+      server = wl_display_create();
+      TEST_CHECK(server != nullptr);
+      int sockets[2];
+      TEST_CHECK(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) == 0);
+      TEST_CHECK(wl_client_create(server, sockets[0]) != nullptr);
+      client = wl_display_connect_to_fd(sockets[1]);
+      TEST_CHECK(client != nullptr);
+      for (auto& output : outputs) {
+        output.global = wl_global_create(server, &wl_output_interface, 3, &output, bindOutput);
+        TEST_CHECK(output.global != nullptr);
+      }
+      if (advertiseManager) {
+        addManager();
+      }
+      registry = wl_display_get_registry(client);
+      static const wl_registry_listener listener{
+          .global =
+              [](void* data, wl_registry* registry, std::uint32_t name, const char* interface, std::uint32_t) {
+                auto& peer = *static_cast<WaylandPeer*>(data);
+                if (std::strcmp(interface, wl_output_interface.name) == 0) {
+                  auto* output = static_cast<wl_output*>(wl_registry_bind(registry, name, &wl_output_interface, 3));
+                  peer.clientOutputs.emplace(name, output);
+                } else if (std::strcmp(interface, zwlr_output_power_manager_v1_interface.name) == 0) {
+                  peer.manager = static_cast<zwlr_output_power_manager_v1*>(
+                      wl_registry_bind(registry, name, &zwlr_output_power_manager_v1_interface, 1)
+                  );
+                }
+              },
+          .global_remove = [](void* data, wl_registry*,
+                              std::uint32_t name) { static_cast<WaylandPeer*>(data)->removedGlobals.push_back(name); },
+      };
+      TEST_CHECK(wl_registry_add_listener(registry, &listener, this) == 0);
+      roundtrip();
+      roundtrip();
+    }
+
+    ~WaylandPeer() {
+      roundtrip();
+      TEST_CHECK(managerDestructions == 0);
+      for (const auto& [name, output] : clientOutputs) {
+        wl_output_release(output);
+      }
+      if (manager != nullptr) {
+        zwlr_output_power_manager_v1_destroy(manager);
+      }
+      roundtrip();
+      wl_registry_destroy(registry);
+      wl_display_disconnect(client);
+      wl_display_destroy_clients(server);
+      wl_display_destroy(server);
+    }
+
+    WaylandPeer(const WaylandPeer&) = delete;
+    WaylandPeer& operator=(const WaylandPeer&) = delete;
+
+    void addManager() {
+      TEST_CHECK(managerGlobal == nullptr);
+      managerGlobal = wl_global_create(server, &zwlr_output_power_manager_v1_interface, 1, this, bindManager);
+      TEST_CHECK(managerGlobal != nullptr);
+    }
+
+    wl_output* outputProxy(std::size_t index) const {
+      TEST_CHECK(outputs[index].resource != nullptr);
+      const auto id = wl_resource_get_id(outputs[index].resource);
+      for (const auto& [name, output] : clientOutputs) {
+        if (wl_proxy_get_id(reinterpret_cast<wl_proxy*>(output)) == id) {
+          return output;
+        }
+      }
+      TEST_CHECK(false);
+      return nullptr;
+    }
+
+    void removeOutput(std::size_t index) {
+      auto* output = outputProxy(index);
+      for (auto it = clientOutputs.begin(); it != clientOutputs.end(); ++it) {
+        if (it->second == output) {
+          clientOutputs.erase(it);
+          break;
+        }
+      }
+      wl_output_release(output);
+      wl_global_destroy(outputs[index].global);
+      outputs[index].global = nullptr;
+    }
+
+    void failOutput(std::size_t index) {
+      auto& output = outputs[index];
+      TEST_CHECK(output.power != nullptr);
+      output.failed = true;
+      zwlr_output_power_v1_send_failed(output.power);
+      roundtrip();
+      roundtrip();
+    }
+
+    void roundtrip() {
+      bool done = false;
+      auto* callback = wl_display_sync(client);
+      TEST_CHECK(callback != nullptr);
+      static const wl_callback_listener listener{
+          .done = [](void* data, wl_callback* callback, std::uint32_t) {
+            *static_cast<bool*>(data) = true;
+            wl_callback_destroy(callback);
+          },
+      };
+      TEST_CHECK(wl_callback_add_listener(callback, &listener, &done) == 0);
+      for (int pass = 0; pass < 8 && !done; ++pass) {
+        TEST_CHECK(wl_display_flush(client) >= 0);
+        TEST_CHECK(wl_event_loop_dispatch(wl_display_get_event_loop(server), 0) >= 0);
+        wl_display_flush_clients(server);
+        TEST_CHECK(wl_display_dispatch_pending(client) >= 0);
+        if (!done) {
+          pollfd fd{.fd = wl_display_get_fd(client), .events = POLLIN, .revents = 0};
+          TEST_CHECK(poll(&fd, 1, 1000) == 1);
+          TEST_CHECK((fd.revents & POLLIN) != 0);
+          TEST_CHECK((fd.revents & (POLLERR | POLLHUP | POLLNVAL)) == 0);
+          TEST_CHECK(wl_display_dispatch(client) >= 0);
+        }
+      }
+      TEST_CHECK(done);
+      TEST_CHECK(wl_display_get_error(client) == 0);
+    }
+
+    std::array<Output, 2> outputs;
+    std::map<std::uint32_t, wl_output*> clientOutputs;
+    std::vector<std::uint32_t> removedGlobals;
+    zwlr_output_power_manager_v1* manager = nullptr;
+    unsigned managerDestructions = 0;
+
+  private:
+    static void bindOutput(wl_client* client, void* data, std::uint32_t version, std::uint32_t id) {
+      auto& output = *static_cast<Output*>(data);
+      output.resource = wl_resource_create(client, &wl_output_interface, static_cast<int>(version), id);
+      TEST_CHECK(output.resource != nullptr);
+      static const struct wl_output_interface implementation{
+          .release = [](wl_client*, wl_resource* resource) {
+            auto& output = *static_cast<Output*>(wl_resource_get_user_data(resource));
+            TEST_CHECK(output.power == nullptr);
+            ++output.releases;
+            wl_resource_destroy(resource);
+          },
+      };
+      wl_resource_set_implementation(output.resource, &implementation, &output, [](wl_resource* resource) {
+        static_cast<Output*>(wl_resource_get_user_data(resource))->resource = nullptr;
+      });
+    }
+
+    static void bindManager(wl_client* client, void* data, std::uint32_t version, std::uint32_t id) {
+      auto* resource =
+          wl_resource_create(client, &zwlr_output_power_manager_v1_interface, static_cast<int>(version), id);
+      TEST_CHECK(resource != nullptr);
+      static const struct zwlr_output_power_manager_v1_interface implementation{
+          .get_output_power = getPower,
+          .destroy = [](wl_client*, wl_resource* resource) {
+            ++static_cast<WaylandPeer*>(wl_resource_get_user_data(resource))->managerDestructions;
+            wl_resource_destroy(resource);
+          },
+      };
+      wl_resource_set_implementation(resource, &implementation, data, nullptr);
+    }
+
+    static void getPower(wl_client* client, wl_resource*, std::uint32_t id, wl_resource* outputResource) {
+      auto& output = *static_cast<Output*>(wl_resource_get_user_data(outputResource));
+      TEST_CHECK(output.power == nullptr);
+      TEST_CHECK(!output.failed);
+      output.power = wl_resource_create(client, &zwlr_output_power_v1_interface, 1, id);
+      TEST_CHECK(output.power != nullptr);
+      ++output.controlsCreated;
+      static const struct zwlr_output_power_v1_interface implementation{
+          .set_mode =
+              [](wl_client*, wl_resource* resource, std::uint32_t mode) {
+                auto& output = *static_cast<Output*>(wl_resource_get_user_data(resource));
+                TEST_CHECK(!output.failed);
+                TEST_CHECK(mode == ZWLR_OUTPUT_POWER_V1_MODE_OFF || mode == ZWLR_OUTPUT_POWER_V1_MODE_ON);
+                output.modes.push_back(mode);
+                zwlr_output_power_v1_send_mode(resource, mode);
+              },
+          .destroy = [](wl_client*, wl_resource* resource) { wl_resource_destroy(resource); },
+      };
+      wl_resource_set_implementation(output.power, &implementation, &output, [](wl_resource* resource) {
+        static_cast<Output*>(wl_resource_get_user_data(resource))->power = nullptr;
+      });
+      zwlr_output_power_v1_send_mode(output.power, ZWLR_OUTPUT_POWER_V1_MODE_ON);
+    }
+
+    wl_display* server = nullptr;
+    wl_display* client = nullptr;
+    wl_registry* registry = nullptr;
+    wl_global* managerGlobal = nullptr;
+  };
+
+  void powerRequestsKeepOutputs() {
+    WaylandPeer peer;
+    OutputPowerService service;
+    service.bind(peer.manager);
+    service.addOutput(peer.outputProxy(0));
+    service.addOutput(peer.outputProxy(1));
+
+    TEST_CHECK(service.setPower(false));
+    peer.roundtrip();
+    for (const auto& output : peer.outputs) {
+      TEST_CHECK(output.modes == std::vector<std::uint32_t>{ZWLR_OUTPUT_POWER_V1_MODE_OFF});
+      TEST_CHECK(output.releases == 0);
+    }
+
+    TEST_CHECK(service.setPower(true));
+    peer.roundtrip();
+    const std::vector<std::uint32_t> cycle{ZWLR_OUTPUT_POWER_V1_MODE_OFF, ZWLR_OUTPUT_POWER_V1_MODE_ON};
+    for (const auto& output : peer.outputs) {
+      TEST_CHECK(output.modes == cycle);
+      TEST_CHECK(output.releases == 0);
+    }
+
+    service.cleanup();
+    peer.roundtrip();
+    TEST_CHECK(!service.setPower(false));
+    TEST_CHECK(peer.outputs[0].power == nullptr);
+    TEST_CHECK(peer.outputs[1].power == nullptr);
+    TEST_CHECK(peer.managerDestructions == 0);
+  }
+
+  void lateManagerAndFailedControl() {
+    WaylandPeer peer(false);
+    OutputPowerService service;
+    service.addOutput(peer.outputProxy(0));
+    service.addOutput(peer.outputProxy(1));
+    TEST_CHECK(!service.setPower(false));
+
+    peer.addManager();
+    peer.roundtrip();
+    peer.roundtrip();
+    service.bind(peer.manager);
+    peer.roundtrip();
+    TEST_CHECK(peer.outputs[0].modes.empty());
+    TEST_CHECK(peer.outputs[1].modes.empty());
+    TEST_CHECK(service.setPower(false));
+    peer.roundtrip();
+
+    peer.failOutput(0);
+    TEST_CHECK(peer.outputs[0].power == nullptr);
+    TEST_CHECK(service.setPower(true));
+    peer.roundtrip();
+    TEST_CHECK(peer.outputs[0].modes == std::vector<std::uint32_t>{ZWLR_OUTPUT_POWER_V1_MODE_OFF});
+    const std::vector<std::uint32_t> cycle{ZWLR_OUTPUT_POWER_V1_MODE_OFF, ZWLR_OUTPUT_POWER_V1_MODE_ON};
+    TEST_CHECK(peer.outputs[1].modes == cycle);
+    TEST_CHECK(peer.outputs[0].controlsCreated == 1);
+    TEST_CHECK(peer.outputs[0].releases == 0);
+    TEST_CHECK(peer.removedGlobals.empty());
+  }
+
+  void removedOutputReceivesNoRequests() {
+    WaylandPeer peer;
+    OutputPowerService service;
+    service.bind(peer.manager);
+    service.addOutput(peer.outputProxy(0));
+    service.addOutput(peer.outputProxy(1));
+    TEST_CHECK(service.setPower(false));
+    peer.roundtrip();
+
+    service.removeOutput(peer.outputProxy(0));
+    peer.removeOutput(0);
+    peer.roundtrip();
+    TEST_CHECK(peer.outputs[0].power == nullptr);
+    TEST_CHECK(peer.outputs[0].releases == 1);
+    TEST_CHECK(service.setPower(true));
+    peer.roundtrip();
+    TEST_CHECK(peer.outputs[0].modes == std::vector<std::uint32_t>{ZWLR_OUTPUT_POWER_V1_MODE_OFF});
+    const std::vector<std::uint32_t> cycle{ZWLR_OUTPUT_POWER_V1_MODE_OFF, ZWLR_OUTPUT_POWER_V1_MODE_ON};
+    TEST_CHECK(peer.outputs[1].modes == cycle);
+
+    service.removeOutput(peer.outputProxy(1));
+    peer.removeOutput(1);
+    TEST_CHECK(!service.setPower(false));
+    peer.roundtrip();
+    TEST_CHECK(peer.outputs[1].modes == cycle);
+  }
+
+} // namespace
+
+int main() {
+  // Bound regressions that accidentally block inside a service call, before the peer can dispatch.
+  alarm(10);
+  powerRequestsKeepOutputs();
+  lateManagerAndFailedControl();
+  removedOutputReceivesNoRequests();
+  return 0;
+}
