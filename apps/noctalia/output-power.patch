+++ b/src/wayland/output_power_service.cpp
@@ -0,0 +1,86 @@
+#include "wayland/output_power_service.h"
+
+#include "wlr-output-power-management-unstable-v1-client-protocol.h"
+
+#include <cstdint>
+
+OutputPowerService::~OutputPowerService() { cleanup(); }
+
+void OutputPowerService::bind(zwlr_output_power_manager_v1* manager) {
+  if (m_manager == manager) {
+    return;
+  }
+  m_manager = manager;
+  for (auto& [output, control] : m_controls) {
+    if (control != nullptr) {
+      zwlr_output_power_v1_destroy(control);
+    }
+    control = createControl(output);
+  }
+}
+
+void OutputPowerService::addOutput(wl_output* output) {
+  auto [it, inserted] = m_controls.try_emplace(output, nullptr);
+  if (inserted) {
+    it->second = createControl(output);
+  }
+}
+
+void OutputPowerService::removeOutput(wl_output* output) {
+  const auto it = m_controls.find(output);
+  if (it == m_controls.end()) {
+    return;
+  }
+  if (it->second != nullptr) {
+    zwlr_output_power_v1_destroy(it->second);
+  }
+  m_controls.erase(it);
+}
+
+bool OutputPowerService::setPower(bool on) {
+  const auto mode = on ? ZWLR_OUTPUT_POWER_V1_MODE_ON : ZWLR_OUTPUT_POWER_V1_MODE_OFF;
+  bool requested = false;
+  for (const auto& [output, control] : m_controls) {
+    if (control != nullptr) {
+      zwlr_output_power_v1_set_mode(control, mode);
+      requested = true;
+    }
+  }
+  return requested;
+}
+
+void OutputPowerService::cleanup() {
+  for (const auto& [output, control] : m_controls) {
+    if (control != nullptr) {
+      zwlr_output_power_v1_destroy(control);
+    }
+  }
+  m_controls.clear();
+  m_manager = nullptr;
+}
+
+zwlr_output_power_v1* OutputPowerService::createControl(wl_output* output) {
+  if (m_manager == nullptr) {
+    return nullptr;
+  }
+  static const zwlr_output_power_v1_listener listener = {
+      .mode = [](void*, zwlr_output_power_v1*, std::uint32_t) {},
+      .failed = [](void* data,
+                   zwlr_output_power_v1* control) { static_cast<OutputPowerService*>(data)->handleFailed(control); },
+  };
+  auto* control = zwlr_output_power_manager_v1_get_output_power(m_manager, output);
+  if (control != nullptr) {
+    zwlr_output_power_v1_add_listener(control, &listener, this);
+  }
+  return control;
+}
+
+void OutputPowerService::handleFailed(zwlr_output_power_v1* control) {
+  for (auto& [output, current] : m_controls) {
+    if (current == control) {
+      zwlr_output_power_v1_destroy(current);
+      current = nullptr;
+      return;
+    }
+  }
+}
