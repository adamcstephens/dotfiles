+#pragma once
+
+#include <unordered_map>
+
+struct wl_output;
+struct zwlr_output_power_manager_v1;
+struct zwlr_output_power_v1;
+
+class OutputPowerService {
+public:
+  OutputPowerService() = default;
+  ~OutputPowerService();
+
+  OutputPowerService(const OutputPowerService&) = delete;
+  OutputPowerService& operator=(const OutputPowerService&) = delete;
+
+  void bind(zwlr_output_power_manager_v1* manager);
+  void addOutput(wl_output* output);
+  void removeOutput(wl_output* output);
+  [[nodiscard]] bool setPower(bool on);
+  void cleanup();
+
+private:
+  zwlr_output_power_v1* createControl(wl_output* output);
+  void handleFailed(zwlr_output_power_v1* control);
+
+  zwlr_output_power_manager_v1* m_manager = nullptr;
+  std::unordered_map<wl_output*, zwlr_output_power_v1*> m_controls;
+};
