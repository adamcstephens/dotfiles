# vi: ft=gitconfig
#
#   git config -f ~/.gitconfig.local user.email me@example.com
#
[alias]
fixup = "!~/.dotfiles/bin/git-fixup"
ftag = push --tags --force
home = "!~/.dotfiles/bin/git-home"
fixhome = remote set-head origin --auto
subup = submodule update --remote --merge --recursive
yolo = commit --amend --no-edit
rm-merged = "!git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" { print $1 }' | xargs -r git branch -D"

[branch]
sort = committerdate

[color]
ui = true

[color "diff"]
meta = blue
frag = magenta
old = red
new = green

[column]
ui = auto

[commit]
gpgsign = true
verbose = true

[core]
editor = ~/.dotfiles/bin/giteditor
pager = delta
untrackedCache = true

[credential]
helper = rbw

[delta]
features = gruvmax-fang
hyperlinks = true
navigate = true

[diff]
algorithm = histogram
colorMoved = plain
mnemonicPrefix = true
renames = true

[fetch]
all = true
prune = true
pruneTags = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[github]
user = adamcstephens

[gpg]
format = ssh

[include]
path = config.os
path = config.delta

[init]
defaultBranch = main

[interactive]
diffFilter = delta --color-only

[merge]
conflictstyle = zdiff3

[pull]
ff = only
rebase = true

[push]
autoSetupRemote = true

[rebase]
autoSquash = true
autoStash = true
updateRefs = true

[rerere]
enabled = true
autoupdate = true

[tag]
gpgsign = true
sort = version:refname

[url "git@github.com:"]
pushInsteadOf = "https://github.com/"

[url "git@gitlab.com:"]
pushInsteadOf = https://gitlab.com/

[url "git@git.sr.ht:~adamcstephens"]
pushInsteadOf = https://git.sr.ht/~adamcstephens

[url "git@codeberg.org:adamcstephens"]
pushInsteadOf = https://codeberg.org/adamcstephens

[user]
name = Adam C. Stephens
email = adam@valkor.net

[includeIf "gitdir:~/git/calmwave/"]
path = ~/git/calmwave/.gitconfig

