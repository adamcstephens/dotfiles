#
#   git config -f ~/.gitconfig.local user.email me@example.com
#
[alias]
fixup = "!~/.dotfiles/bin/git-fixup"
ftag = push --tags --force
home = "!~/.dotfiles/bin/git-home"
fixhome = remote set-head origin --auto
subup = submodule update --remote --merge --recursive
yolo = commit --amend --no-edit

[color]
ui = true

[color "diff"]
meta = blue
frag = magenta
old = red
new = green

[commit]
gpgsign = true

[core]
editor = ~/.dotfiles/bin/giteditor

[credential]
helper = rbw

[fetch]
prune = true

[github]
user = adamcstephens

[gpg]
format = ssh

[include]
path = ~/.gitconfig.local
path = config.os

[init]
defaultBranch = main

[pull]
ff = only
rebase = true

[rebase]
autoStash = true
updateRefs = true

[tag]
gpgsign = true

[url "git@github.com:"]
pushInsteadOf = "https://github.com/"

[url "git@github.com:kentstate-emat"]
insteadOf = https://github.com/kentstate-emat

[url "git@github.com:mitchellh/ghostty"]
insteadOf = https://github.com/mitchellh/ghostty

[url "git@gitlab.com:"]
pushInsteadOf = https://gitlab.com/

[url "git@git.sr.ht:~adamcstephens"]
pushInsteadOf = https://git.sr.ht/~adamcstephens

[url "git@codeberg.org:adamcstephens"]
pushInsteadOf = https://codeberg.org/adamcstephens

[includeIf "hasconfig:remote.*.url:git@github.com:lxc/**"]
  path = ~/.dotfiles/apps/git/config-lxc

[includeIf "hasconfig:remote.*.url:https://github.com/lxc/**"]
  path = ~/.dotfiles/apps/git/config-lxc

[user]
name = Adam C. Stephens

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
